#!/usr/bin/env python3
"""bh-note — the agent's only way to write to the board (via an inbox the runner ingests).

  bh-note fact "title" [-s summary] [-e evidence_path]
  bh-note intent "what I will try next"
  bh-note done I12 "outcome"
  bh-note finding "title" --severity high --class idor --url URL --poc-file poc.sh \
          --summary "..." --not-proven "..."
  bh-note todo auth|waf|account|scope-question|refusal|other "title" [-d detail]
  bh-note show 42          # full summary/evidence of fact 42
  bh-note frontier         # current board view
"""
import argparse
import json
import os
import sys
import time
from pathlib import Path

BH = Path(os.environ.get("BH_DIR", "/work/.bh"))
PROGRAM = os.environ.get("BH_PROGRAM", "")


def emit(rec):
    BH.mkdir(parents=True, exist_ok=True)
    rec["ts"] = time.time()
    rec["program"] = PROGRAM
    with open(BH / "notes.jsonl", "a", encoding="utf-8") as fh:
        fh.write(json.dumps(rec, ensure_ascii=False) + "\n")
    print(f"ok {rec['op']}")


def main():
    p = argparse.ArgumentParser(prog="bh-note")
    sub = p.add_subparsers(dest="op", required=True)
    f = sub.add_parser("fact"); f.add_argument("title"); f.add_argument("-s", "--summary", default=""); f.add_argument("-e", "--evidence", default="")
    f.add_argument("-k", "--kind", default="fact", choices=["fact", "recon", "handoff", "dead-end"])
    i = sub.add_parser("intent"); i.add_argument("title")
    d = sub.add_parser("done"); d.add_argument("intent_id"); d.add_argument("outcome")
    fi = sub.add_parser("finding"); fi.add_argument("title")
    fi.add_argument("--severity", required=True, choices=["critical", "high", "medium", "low", "info"])
    fi.add_argument("--class", dest="vuln_class", required=True); fi.add_argument("--url", required=True)
    fi.add_argument("--poc-file", required=True, help="script/curl that reproduces the issue")
    fi.add_argument("--summary", required=True); fi.add_argument("--not-proven", default="")
    t = sub.add_parser("todo"); t.add_argument("kind"); t.add_argument("title"); t.add_argument("-d", "--detail", default="")
    s = sub.add_parser("show"); s.add_argument("fact_id")
    sub.add_parser("frontier")
    a = p.parse_args()

    if a.op == "show":
        facts = json.loads((BH / "facts.json").read_text()) if (BH / "facts.json").exists() else {}
        rec = facts.get(str(a.fact_id).lstrip("#"))
        print(json.dumps(rec, indent=1, ensure_ascii=False) if rec else "unknown fact (snapshot refreshes each segment)")
        return
    if a.op == "frontier":
        fr = BH / "frontier.md"
        print(fr.read_text() if fr.exists() else "(no frontier yet)")
        return
    if a.op == "finding":
        poc = Path(a.poc_file)
        if not poc.is_file():
            sys.exit(f"poc file not found: {poc}")
        emit({"op": "finding", "title": a.title, "severity": a.severity, "vuln_class": a.vuln_class,
              "url": a.url, "poc": poc.read_text()[:20000], "evidence": str(poc.resolve()),
              "summary": a.summary, "not_proven": a.not_proven})
        return
    rec = {k: v for k, v in vars(a).items() if v is not None}
    emit(rec)


if __name__ == "__main__":
    main()
